{
  "expo": {
    "name": "SMARTFIX Admin",
    "slug": "smartfix-admin",
    "scheme": "smartfixadmin",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.placeholder.appid"
    },
    "android": {
      "package": "com.placeholder.appid",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "@react-native-vector-icons/ionicons",
      "expo-secure-store",
      "expo-font"
    ]
  }
}
