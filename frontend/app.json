{
  "expo": {
    "name": "SMARTFIX",
    "slug": "smartfix-customer",
    "scheme": "smartfix",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.trimoduleapp.q7iy0v",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Find your address for faster doorstep service",
        "NSMicrophoneUsageDescription": "Search services and chat with support by voice"
      }
    },
    "android": {
      "package": "com.emergent.trimoduleapp.q7iy0v",
      "edgeToEdgeEnabled": true,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "@react-native-vector-icons/ionicons",
      "expo-secure-store",
      "expo-font",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Find your address for faster doorstep service"
        }
      ],
      ["expo-audio", { "microphonePermission": "Search services and chat with support by voice" }]
    ]
  }
}
