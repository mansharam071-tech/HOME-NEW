{
  "expo": {
    "name": "HomeServe",
    "slug": "homeserve-customer",
    "scheme": "homeserve",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.placeholder.appid",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Find your address for faster doorstep service"
      }
    },
    "android": {
      "package": "com.placeholder.appid",
      "edgeToEdgeEnabled": true,
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"]
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "@react-native-vector-icons/ionicons",
      "expo-secure-store",
      "expo-font",
      ["expo-location", { "locationWhenInUsePermission": "Find your address for faster doorstep service" }]
    ]
  }
}
